{
  "name": "boundaries-kit",
  "version": "0.1.0",
  "description": "Hard project limits as checked manifests; AI rules as principles only.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "boundaries": "node/bin/boundaries.mjs"
  },
  "exports": {
    ".": "./node/src/index.js",
    "./testing": "./node/src/testing.js",
    "./hook": "./hooks/protect-boundaries.mjs",
    "./schema/*": "./schema/*",
    "./rules/*": "./rules/*",
    "./package.json": "./package.json"
  },
  "files": [
    "node/bin",
    "node/src",
    "hooks",
    "rules",
    "schema",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --test-reporter=dot \"node/test/**/*.test.js\"",
    "test:cross": "node --test --test-reporter=dot \"tools/cross/**/*.test.js\""
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "dependency-cruiser": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "dependency-cruiser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
