{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["node/**/*.js", "node/**/*.mjs", "hooks/**/*.mjs", "tools/**/*.js", "eslint.config.js"],
  "exclude": ["node_modules", ".scratch", ".claude", "fixtures", "examples"]
}
