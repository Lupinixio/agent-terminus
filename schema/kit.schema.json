{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundaries-kit:kit:1",
  "title": "boundaries-kit project configuration (.boundaries/kit.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      }
    },
    "rules_lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relGlob"
          }
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relGlob"
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "ask",
            "deny"
          ]
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sys_path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relPath"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tsconfig": {
          "$ref": "#/$defs/relPath"
        }
      }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[^*?\\[\\]{}]+$"
    },
    "relGlob": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[^\\[\\]{}]+$"
    }
  }
}
