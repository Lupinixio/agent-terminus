{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundaries-kit:manifest:1",
  "title": "boundaries-kit component manifest (.boundaries/<component>.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component"],
  "properties": {
    "schema_version": { "const": 1 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "root", "principle", "decisions"],
      "properties": {
        "name": { "type": "string", "pattern": "^(?!kit$)[a-z][a-z0-9-]{0,62}$" },
        "language": { "enum": ["python", "node"] },
        "root": { "$ref": "#/$defs/relPath" },
        "package": { "$ref": "#/$defs/dotted" },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/relGlob" } },
        "principle": { "type": "string", "minLength": 1, "maxLength": 300 },
        "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relPath" } }
      },
      "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
      "then": { "required": ["package"] }
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external", "builtin"],
      "properties": {
        "internal": { "$ref": "#/$defs/allowList" },
        "external": { "$ref": "#/$defs/allowList" },
        "builtin": { "$ref": "#/$defs/allowList" }
      }
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden"],
      "properties": {
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/callPattern" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern"],
                "properties": {
                  "pattern": { "$ref": "#/$defs/callPattern" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "exact"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "provider": { "$ref": "#/$defs/ref" },
          "exact": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "provider"],
          "properties": {
            "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "provider": { "$ref": "#/$defs/ref" }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["names", "probe"],
          "properties": {
            "names": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
            },
            "probe": { "$ref": "#/$defs/ref" }
          }
        }
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relGlob" } }
      }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[^*?\\[\\]{}]+$"
    },
    "relGlob": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[^\\[\\]{}]+$"
    },
    "dotted": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
    "ref": {
      "type": "string",
      "pattern": "^([A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*|\\./[^#]+#[A-Za-z_$][\\w$]*)$"
    },
    "callPattern": {
      "type": "string",
      "pattern": "^(\\*\\.)?[A-Za-z_$*][\\w$*]*(\\.[A-Za-z_$*][\\w$*]*)*$"
    },
    "allowList": {
      "oneOf": [
        { "const": "any" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["target", "only_from"],
                "properties": {
                  "target": { "type": "string", "minLength": 1 },
                  "only_from": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
